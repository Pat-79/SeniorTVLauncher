<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SeniorTVLauncher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/background_default</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/background_default</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.SeniorTVLauncher.Fullscreen" parent="Theme.SeniorTVLauncher">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.SeniorTVLauncher.Settings" parent="Theme.SeniorTVLauncher">
        <item name="android:windowBackground">@color/settings_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.SeniorTVLauncher.Dialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@color/background_default</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>
</resources>
