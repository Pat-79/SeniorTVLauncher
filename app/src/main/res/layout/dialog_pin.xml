<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_default"
    android:padding="32dp">

    <!-- Title -->
    <TextView
        android:id="@+id/pin_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pin_title"
        android:textSize="24sp"
        android:textColor="@color/text_primary"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Generated code display -->
    <TextView
        android:id="@+id/generated_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="64sp"
        android:textColor="@color/accent"
        android:textStyle="bold"
        android:gravity="center"
        android:letterSpacing="0.5"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/pin_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Entered code display -->
    <TextView
        android:id="@+id/entered_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="36sp"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:letterSpacing="0.3"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/generated_code"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Number pad -->
    <LinearLayout
        android:id="@+id/num_pad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/entered_code"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <Button android:id="@+id/btn1" android:layout_width="80dp" android:layout_height="80dp"
                android:text="1" android:textSize="28sp" android:textColor="@color/text_primary"
                android:background="@color/button_background" android:focusable="true"
                android:focusableInTouchMode="true" android:focusedByDefault="true"
                android:nextFocusRight="@id/btn2" android:nextFocusLeft="@id/btn3"
                android:nextFocusDown="@id/btn4" android:nextFocusUp="@id/btn_backspace"
                android:layout_margin="4dp"/>
            <Button android:id="@+id/btn2" android:layout_width="80dp" android:layout_height="80dp"
                android:text="2" android:textSize="28sp" android:textColor="@color/text_primary"
                android:background="@color/button_background" android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/btn3" android:nextFocusLeft="@id/btn1"
                android:nextFocusDown="@id/btn5" android:nextFocusUp="@id/btn0"
                android:layout_margin="4dp"/>
            <Button android:id="@+id/btn3" android:layout_width="80dp" android:layout_height="80dp"
                android:text="3" android:textSize="28sp" android:textColor="@color/text_primary"
                android:background="@color/button_background" android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/btn1" android:nextFocusLeft="@id/btn2"
                android:nextFocusDown="@id/btn6" android:nextFocusUp="@id/btn_confirm"
                android:layout_margin="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <Button android:id="@+id/btn4" android:layout_width="80dp" android:layout_height="80dp"
                android:text="4" android:textSize="28sp" android:textColor="@color/text_primary"
                android:background="@color/button_background" android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/btn5" android:nextFocusLeft="@id/btn6"
                android:nextFocusDown="@id/btn7" android:nextFocusUp="@id/btn1"
                android:layout_margin="4dp"/>
            <Button android:id="@+id/btn5" android:layout_width="80dp" android:layout_height="80dp"
                android:text="5" android:textSize="28sp" android:textColor="@color/text_primary"
                android:background="@color/button_background" android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/btn6" android:nextFocusLeft="@id/btn4"
                android:nextFocusDown="@id/btn8" android:nextFocusUp="@id/btn2"
                android:layout_margin="4dp"/>
            <Button android:id="@+id/btn6" android:layout_width="80dp" android:layout_height="80dp"
                android:text="6" android:textSize="28sp" android:textColor="@color/text_primary"
                android:background="@color/button_background" android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/btn4" android:nextFocusLeft="@id/btn5"
                android:nextFocusDown="@id/btn9" android:nextFocusUp="@id/btn3"
                android:layout_margin="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <Button android:id="@+id/btn7" android:layout_width="80dp" android:layout_height="80dp"
                android:text="7" android:textSize="28sp" android:textColor="@color/text_primary"
                android:background="@color/button_background" android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/btn8" android:nextFocusLeft="@id/btn9"
                android:nextFocusDown="@id/btn_backspace" android:nextFocusUp="@id/btn4"
                android:layout_margin="4dp"/>
            <Button android:id="@+id/btn8" android:layout_width="80dp" android:layout_height="80dp"
                android:text="8" android:textSize="28sp" android:textColor="@color/text_primary"
                android:background="@color/button_background" android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/btn9" android:nextFocusLeft="@id/btn7"
                android:nextFocusDown="@id/btn0" android:nextFocusUp="@id/btn5"
                android:layout_margin="4dp"/>
            <Button android:id="@+id/btn9" android:layout_width="80dp" android:layout_height="80dp"
                android:text="9" android:textSize="28sp" android:textColor="@color/text_primary"
                android:background="@color/button_background" android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/btn7" android:nextFocusLeft="@id/btn8"
                android:nextFocusDown="@id/btn_confirm" android:nextFocusUp="@id/btn6"
                android:layout_margin="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <Button android:id="@+id/btn_backspace" android:layout_width="80dp" android:layout_height="80dp"
                android:text="⌫" android:textSize="24sp" android:textColor="@color/text_primary"
                android:background="@color/button_background" android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/btn0" android:nextFocusLeft="@id/btn_confirm"
                android:nextFocusDown="@id/btn1" android:nextFocusUp="@id/btn7"
                android:layout_margin="4dp"/>
            <Button android:id="@+id/btn0" android:layout_width="80dp" android:layout_height="80dp"
                android:text="0" android:textSize="28sp" android:textColor="@color/text_primary"
                android:background="@color/button_background" android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/btn_confirm" android:nextFocusLeft="@id/btn_backspace"
                android:nextFocusDown="@id/btn2" android:nextFocusUp="@id/btn8"
                android:layout_margin="4dp"/>
            <Button android:id="@+id/btn_confirm" android:layout_width="80dp" android:layout_height="80dp"
                android:text="✓" android:textSize="28sp" android:textColor="@color/text_primary"
                android:background="@color/accent" android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/btn_backspace" android:nextFocusLeft="@id/btn0"
                android:nextFocusDown="@id/btn3" android:nextFocusUp="@id/btn9"
                android:layout_margin="4dp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Countdown hint shown below the numpad -->
    <TextView
        android:id="@+id/timeout_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/num_pad"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
