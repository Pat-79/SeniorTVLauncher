<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_default"
    android:padding="32dp">

    <!-- Title -->
    <TextView
        android:id="@+id/pin_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/pin_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Generated code display -->
    <TextView
        android:id="@+id/generated_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:letterSpacing="0.5"
        android:textColor="@color/accent"
        android:textSize="48sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pin_title" />

    <!-- Entered code display -->
    <TextView
        android:id="@+id/entered_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:letterSpacing="0.3"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/generated_code" />

    <!-- Number pad -->
    <LinearLayout
        android:id="@+id/num_pad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/entered_code"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Row 1: 1 2 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn1"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_margin="4dp"
                android:background="@drawable/btn_numpad_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:focusedByDefault="true"
                android:nextFocusLeft="@id/btn3"
                android:nextFocusRight="@id/btn2"
                android:nextFocusUp="@id/btn_delete"
                android:nextFocusDown="@id/btn4"
                android:text="1"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn2"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_margin="4dp"
                android:background="@drawable/btn_numpad_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btn1"
                android:nextFocusRight="@id/btn3"
                android:nextFocusUp="@id/btn0"
                android:nextFocusDown="@id/btn5"
                android:text="2"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn3"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_margin="4dp"
                android:background="@drawable/btn_numpad_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btn2"
                android:nextFocusRight="@id/btn1"
                android:nextFocusUp="@id/btn_confirm"
                android:nextFocusDown="@id/btn6"
                android:text="3"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2: 4 5 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn4"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_margin="4dp"
                android:background="@drawable/btn_numpad_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btn6"
                android:nextFocusRight="@id/btn5"
                android:nextFocusUp="@id/btn1"
                android:nextFocusDown="@id/btn7"
                android:text="4"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn5"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_margin="4dp"
                android:background="@drawable/btn_numpad_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btn4"
                android:nextFocusRight="@id/btn6"
                android:nextFocusUp="@id/btn2"
                android:nextFocusDown="@id/btn8"
                android:text="5"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn6"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_margin="4dp"
                android:background="@drawable/btn_numpad_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btn5"
                android:nextFocusRight="@id/btn4"
                android:nextFocusUp="@id/btn3"
                android:nextFocusDown="@id/btn9"
                android:text="6"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 3: 7 8 9 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn7"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_margin="4dp"
                android:background="@drawable/btn_numpad_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btn9"
                android:nextFocusRight="@id/btn8"
                android:nextFocusUp="@id/btn4"
                android:nextFocusDown="@id/btn_delete"
                android:text="7"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn8"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_margin="4dp"
                android:background="@drawable/btn_numpad_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btn7"
                android:nextFocusRight="@id/btn9"
                android:nextFocusUp="@id/btn5"
                android:nextFocusDown="@id/btn0"
                android:text="8"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn9"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_margin="4dp"
                android:background="@drawable/btn_numpad_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btn8"
                android:nextFocusRight="@id/btn7"
                android:nextFocusUp="@id/btn6"
                android:nextFocusDown="@id/btn_confirm"
                android:text="9"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 4: Delete | 0 | Confirm -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_delete"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_margin="4dp"
                android:background="@drawable/btn_delete_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btn_confirm"
                android:nextFocusRight="@id/btn0"
                android:nextFocusUp="@id/btn7"
                android:nextFocusDown="@id/btn1"
                android:text="⌫ Del"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btn0"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_margin="4dp"
                android:background="@drawable/btn_numpad_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btn_delete"
                android:nextFocusRight="@id/btn_confirm"
                android:nextFocusUp="@id/btn8"
                android:nextFocusDown="@id/btn2"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_confirm"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_margin="4dp"
                android:background="@drawable/btn_confirm_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btn0"
                android:nextFocusRight="@id/btn_delete"
                android:nextFocusUp="@id/btn9"
                android:nextFocusDown="@id/btn3"
                android:text="✓ OK"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Countdown hint shown below the numpad -->
    <TextView
        android:id="@+id/timeout_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/num_pad"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
