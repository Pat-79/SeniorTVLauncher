<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/button_background"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/left_section"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_select_app"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/slot_label"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:text="#1" />

        <ImageView
            android:id="@+id/slot_app_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="fitCenter"
            android:layout_marginStart="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/slot_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="8dp"
            android:text="@string/empty_slot" />

    </LinearLayout>

    <Button
        android:id="@+id/btn_select_app"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/select_app"
        android:textSize="14sp"
        android:background="@color/settings_background"
        android:textColor="@color/text_primary"
        android:focusable="true"
        app:layout_constraintEnd_toStartOf="@id/btn_remove_app"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="4dp" />

    <Button
        android:id="@+id/btn_remove_app"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/remove"
        android:textSize="14sp"
        android:background="@color/settings_background"
        android:textColor="@color/text_primary"
        android:focusable="true"
        app:layout_constraintEnd_toStartOf="@id/btn_move_up"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="4dp" />

    <Button
        android:id="@+id/btn_move_up"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="▲"
        android:textSize="16sp"
        android:background="@color/settings_background"
        android:textColor="@color/text_primary"
        android:focusable="true"
        app:layout_constraintEnd_toStartOf="@id/btn_move_down"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="4dp" />

    <Button
        android:id="@+id/btn_move_down"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="▼"
        android:textSize="16sp"
        android:background="@color/settings_background"
        android:textColor="@color/text_primary"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
